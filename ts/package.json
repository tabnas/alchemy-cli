{
  "name": "@tabnas/alchemy-cli",
  "version": "0.1.13",
  "main": "dist/cli.js",
  "type": "commonjs",
  "types": "dist/cli.d.ts",
  "description": "The alchemy command: check, explain and run alchemy programs over JSON, and translate documents between formats, with the tabnas transducers and renderers.",
  "homepage": "https://tabnas.dev",
  "keywords": [
    "parser",
    "dsl",
    "streaming",
    "transducer",
    "cli"
  ],
  "author": "Richard Rodger (http://richardrodger.com)",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --build src && tsc --build test",
    "watch": "tsc --build src test -w",
    "clean": "rm -rf node_modules dist dist-test package-lock.json",
    "reset": "npm run clean && npm i && npm run build && npm test",
    "test": "npm run build && node --enable-source-maps --test \"dist-test/*.test.js\""
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/cli.js"
  },
  "bin": {
    "alchemy": "bin/alchemy"
  },
  "peerDependencies": {
    "@tabnas/abnf": ">=0.4.24",
    "@tabnas/alchemy": ">=0.2.7",
    "@tabnas/c": ">=0.5.15",
    "@tabnas/chess": ">=0.1.17",
    "@tabnas/css": ">=0.5.16",
    "@tabnas/csv": ">=0",
    "@tabnas/ebnf": ">=0.1.19",
    "@tabnas/expr": ">=0.5.19",
    "@tabnas/feed": ">=0.6.18",
    "@tabnas/gbnf": ">=0.1.20",
    "@tabnas/ini": ">=0.5.20",
    "@tabnas/json": ">=0",
    "@tabnas/json5": ">=0.5.16",
    "@tabnas/jsonc": ">=0",
    "@tabnas/jsonic": ">=0",
    "@tabnas/jsonl": ">=0.1.17",
    "@tabnas/markdown": ">=0",
    "@tabnas/parser": ">=0",
    "@tabnas/proto": ">=0.6.11",
    "@tabnas/render": ">=0.2.5",
    "@tabnas/semver": ">=0.0.11",
    "@tabnas/toml": ">=0.5.18",
    "@tabnas/transduce": ">=0.2.8",
    "@tabnas/xml": ">=0.7.18",
    "@tabnas/yaml": ">=0.5.24",
    "@tabnas/zon": ">=0.5.17"
  },
  "devDependencies": {
    "@tabnas/alchemy": "*",
    "@tabnas/csv": "*",
    "@tabnas/ini": "*",
    "@tabnas/json": "*",
    "@tabnas/json5": "*",
    "@tabnas/jsonc": "*",
    "@tabnas/jsonic": "*",
    "@tabnas/jsonl": "*",
    "@tabnas/markdown": "*",
    "@tabnas/parser": "*",
    "@tabnas/render": "*",
    "@tabnas/support": "*",
    "@tabnas/toml": "*",
    "@tabnas/transduce": "*",
    "@tabnas/xml": "*",
    "@tabnas/yaml": "*",
    "@tabnas/zon": "*",
    "@types/node": "26.x",
    "typescript": "7.x"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/tabnas/alchemy-cli.git",
    "directory": "ts"
  }
}
